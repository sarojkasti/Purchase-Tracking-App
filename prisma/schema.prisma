// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Reference / Master data ----------

model Agent {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  vendors        Vendor[]
  freightRatePolicies AgentFreightRatePolicy[]
  purchaseOrders PurchaseOrder[]
}

// Versioned freight/cost rate by item category & transport mode, owned by the Agent
// (from Master sheet columns) - which version applies is chosen by the PO's order date.
model AgentFreightRatePolicy {
  id            String   @id @default(cuid())
  agentId       String
  agent         Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  effectiveFrom DateTime
  itemCategory  String // Sunglasses | Frames | Clip On | Kids
  transportMode String // Road | Airway
  rate          Float
  createdAt     DateTime @default(now())

  @@unique([agentId, effectiveFrom, itemCategory, transportMode])
}

model Vendor {
  id        String   @id @default(cuid())
  name      String
  shortName String   @unique // e.g. GSP, DTG, JSG - used as PO prefix
  address   String?
  agentId   String?
  agent     Agent?   @relation(fields: [agentId], references: [id])
  remarks   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchaseOrders PurchaseOrder[]
  payments       Payment[]
  paymentPolicies VendorPaymentPolicy[]
}

// Versioned payment terms: which policy applies is chosen by the PO's order date
// vs each policy's effectiveFrom, taking the latest policy whose effectiveFrom <= order date
// (or the earliest policy at all, if the order predates every recorded policy).
model VendorPaymentPolicy {
  id                   String    @id @default(cuid())
  vendorId             String
  vendor               Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  effectiveFrom        DateTime // policy applies to PO order dates on/after this date
  advancePercent       Float // e.g. 0.3 = 30%
  advanceOn            String // "Order" | "Shipping" etc - when advance is triggered
  orderConfirmAfterAdv Boolean   @default(true)
  balancePercent       Float // e.g. 0.7
  balanceFrom          String? // "Shipping" etc - when balance is triggered
  balanceAfterDays     Int? // days after balanceFrom trigger
  notes                String?
  createdAt            DateTime  @default(now())

  @@unique([vendorId, effectiveFrom])
}


// AD <-> BS calendar mapping, mirrors "Date Master" sheet
model DateMaster {
  id          String   @id @default(cuid())
  englishDate DateTime @unique
  nepaliDate  String // e.g. "2081/2/10"
  nepaliYear  Int
  nepaliMonth String
  weekLabel   String? // e.g. "Shrawan Second Week"
}

// ---------- Simple named-list masters ----------
// Covers Brand, Item Type, Gender, Mfg Type, Production Status,
// Front/Temple/Lens Material, Shipping Method, Shipping Status Stage —
// each is just a managed list of named options, distinguished by `type`.
// Agent is its own model (see above) since it owns freight rate policies.
// Price ranges live per Brand+ItemType in MrpRange, not as a global list.
enum MasterType {
  BRAND
  ITEM_TYPE
  GENDER
  MFG_TYPE
  FRONT_MATERIAL
  TEMPLE_MATERIAL
  LENS_MATERIAL
  CUSTOM_POINT
}

model SimpleMaster {
  id        String     @id @default(cuid())
  type      MasterType
  name      String
  sortOrder Int        @default(0)
  createdAt DateTime   @default(now())

  @@unique([type, name])
}

// Color master: name + factory-style serial code (e.g. "Black" / "C1").
// Items reference chosen colors by name in POItem.colors (String[]).
model Color {
  id        String   @id @default(cuid())
  name      String   @unique
  code      String // e.g. "C1", "C2"
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

// MRP price ranges scoped to a Brand + Item Type combo (e.g. "Limitless Sunglasses"
// has its own range list, separate from "Limitless Frames"). Labels only, same
// free-text style as the global Price Range master.
model MrpRange {
  id       String @id @default(cuid())
  brand    String
  itemType String
  label    String // e.g. "1901-2500"
  sortOrder Int   @default(0)

  @@unique([brand, itemType, label])
}

// Multiplier applied to landed cost to derive MRP, one value per Brand.
model MrpMultiplier {
  id        String   @id @default(cuid())
  brand     String   @unique
  multiplier Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Reusable product record keyed by Chinese SKU, so entering the same SKU on a
// later PO auto-fills its known details instead of retyping everything.
model Product {
  id         String  @id @default(cuid())
  chineseSku String  @unique
  newmewSku  String?

  specificName String?
  itemType     String? // Sunglasses | Frames | Clip On | Kids | Lens
  brand        String? // Newmew | Limitless | Other, from Brand master
  gender       String?
  size         String? // e.g. "56-19-148"

  front  String?
  temple String?
  lens   String?

  mrp      Float?
  imageUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------- Purchase Orders ----------

// The PO's position in its production/shipping pipeline. Two sequences share
// this enum depending on the PO's mfgType (see poStages.ts): PRODUCTION POs
// use START_PRODUCTION, READY_GOODS POs use PRINTING_PROCESS; both then share
// GOODS_COMPLETED -> QC -> READY_TO_SHIP -> SHIPPED -> CUSTOM -> RECEIVED.
// SHIPPED/CUSTOM/RECEIVED are automatic (from shipment/receiving data); every
// earlier step is a manual, strictly-sequential advance. HOLD and CANCELLED
// (on the separate PurchaseOrder.onHold/cancelled flags) override the stage
// display without losing the underlying position.
enum OrderStage {
  ORDER_PLACED
  START_PRODUCTION
  PRINTING_PROCESS
  GOODS_COMPLETED
  QC
  READY_TO_SHIP
  SHIPPED
  CUSTOM
  RECEIVED
}

enum MfgType {
  READY_GOODS
  PRODUCTION
}

enum TransportMode {
  ROAD
  AIRWAY
  SEA
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
}

model PurchaseOrder {
  id          String   @id @default(cuid())
  poNumber    String   @unique // e.g. "DTG-PO7.2"
  piNumber    String? // Chinese PI No

  vendorId    String
  vendor      Vendor   @relation(fields: [vendorId], references: [id])

  agentId     String?
  agent       Agent?   @relation(fields: [agentId], references: [id])

  orderDateAD DateTime
  orderDateBS String?
  orderMonth  String? // Nepali month, denormalized for quick filtering

  stage         OrderStage @default(ORDER_PLACED)
  onHold        Boolean    @default(false)
  cancelled     Boolean    @default(false)
  transportMode TransportMode @default(ROAD)

  gender  String?

  // Quantities (rolled up from items, kept for quick display but items are source of truth)
  unitsOrdered  Int @default(0)
  unitsShipped  Int @default(0)
  unitsReceived Int @default(0)

  // Financials in RMB / NPR
  piAmountRMB Float @default(0)
  piAmountNPR Float @default(0)

  estAdvanceRMB    Float @default(0)
  estAdvanceNPR    Float @default(0)
  estAdvanceDate   DateTime?
  estAdvanceDateManual Boolean @default(false)
  paidAdvanceRMB   Float @default(0)
  paidAdvanceNPR   Float @default(0)
  advancePaymentStatus PaymentStatus @default(PENDING)

  estBalanceRMB    Float @default(0)
  estBalanceNPR    Float @default(0)
  estBalanceDate   DateTime?
  estBalanceDateManual Boolean @default(false)
  paidBalanceRMB   Float @default(0)
  paidBalanceNPR   Float @default(0)
  balancePaymentStatus PaymentStatus @default(PENDING)

  estCustomAmountNPR    Float @default(0)
  actualCustomAmountNPR Float @default(0)

  // Extra landed costs in RMB, added on top of piAmountRMB for the PO's total amount
  printingCostRMB     Float @default(0)
  chinaFreightCostRMB Float @default(0)
  inspectionCostRMB   Float @default(0)

  // Lifecycle dates
  estGoodCompletionDate    DateTime?
  revisedGoodCompletionDate DateTime?
  actualGoodCompletionDate DateTime?

  estFactoryShipmentDate    DateTime?
  actualFactoryShipmentDate DateTime?
  shipmentShifted           Boolean @default(false)

  estCustomArrivalDate  DateTime?
  actualCustomDate      DateTime?
  estCustomClearanceDate DateTime?

  estArrivalDateAD   DateTime?
  estArrivalDateBS   String?
  estArrivalWeek     String?
  actualArrivalDateAD DateTime?
  actualArrivalWeek   String?

  discrepancyDays Int?
  remarks         String?
  sourceLink      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items          POItem[]
  payments       Payment[]
  shipments      Shipment[]
  attachments    POAttachment[]
  stageEvents    StageEvent[]
  poNotes        PONote[]
  dateRevisions  PODateRevision[]
}

// Records the actual date each pipeline stage was reached, for the PO's own
// manual stages (Order Placed through Ready to Ship) and, separately, for
// each shipment's own Shipped/At Custom/Received progress (shipmentId set).
// One row per (po or shipment, stage) - re-advancing to a stage never
// happens in this pipeline, so this doubles as the history log itself.
// Compared against whichever existing estimate field maps to that stage
// (see stageEstimateField in poStages.ts) - most manual stages have no
// estimate field yet and just show the actual date on its own.
model StageEvent {
  id         String    @id @default(cuid())
  poId       String
  po         PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  shipmentId String?
  shipment   Shipment? @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  stage      String
  actualDate DateTime

  createdAt DateTime @default(now())

  // A PO-level stage event has shipmentId null; a shipment-level one has it
  // set. Uniqueness is enforced in application code (upsert-by-lookup)
  // rather than a DB constraint, since Postgres treats multiple NULLs as
  // distinct and can't uniquely constrain the PO-level rows this way.
  @@index([poId, stage])
  @@index([shipmentId, stage])
}

enum POAttachmentType {
  PI
  CI
  COSTING_SHEET
  OTHER
}

model POAttachment {
  id     String @id @default(cuid())
  poId   String
  po     PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)

  type       POAttachmentType
  fileName   String
  url        String
  mimeType   String
  fileSize   Int

  uploadedAt DateTime @default(now())
}

model POItem {
  id      String @id @default(cuid())
  poId    String
  po      PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)

  chineseSku String?
  newmewSku  String?
  orderType  String? // "New Order" etc
  specificName String?
  itemType   String? // Sunglasses | Frames | Clip On | Kids | Lens
  mfgType    MfgType?
  brand      String? // Newmew | Limitless | Other, from Brand master
  category   String? // Acetate TAC, Metal TAC, etc (material combo)
  gender     String?
  size       String? // e.g. "56-19-148"

  front  String?
  temple String?
  lens   String?
  colors String[] @default([])

  imageUrl String?

  mrp        Float?
  priceRangeLabel String? // e.g. "1901-2500"

  unitsOrdered  Int @default(0)
  shippedQty    Int @default(0)
  receivedQty   Int @default(0)

  materialCost Float?
  printingCost Float?
  freightCost  Float?
  amountRMB    Float?
  convRate     Float?
  amountNPR    Float?
  estCustomNPR Float?

  estArrivalDate DateTime?
  goodsStatus    String?

  shipmentLines ShipmentItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum PaymentType {
  ADVANCE
  BALANCE
  CUSTOM_DUTY
  OTHER
}

model Payment {
  id       String   @id @default(cuid())
  poId     String
  po       PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  vendorId String
  vendor   Vendor   @relation(fields: [vendorId], references: [id])

  paymentDate DateTime
  paymentType PaymentType
  amountRMB   Float
  exchangeRate Float
  amountNPR   Float

  // Optional breakdown by item category, mirrors "Actual Payment" sheet
  sunglassesNPR Float?
  framesNPR     Float?
  clipOnNPR     Float?
  kidsNPR       Float?
  lensNPR       Float?

  notes String?

  advices PaymentAdvice[]

  createdAt DateTime @default(now())
}

model PaymentAdvice {
  id          String   @id @default(cuid())
  paymentId   String
  payment     Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  fileName    String
  url         String
  mimeType    String
  fileSize    Int
  uploadedAt  DateTime @default(now())
}

model PONote {
  id        String        @id @default(cuid())
  poId      String
  po        PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime      @default(now())
}

// Audit log for estimate date revisions — recorded whenever recalcPoTotals
// updates an estimate because an upstream actual date was set.
model PODateRevision {
  id        String        @id @default(cuid())
  poId      String
  po        PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  field     String        // e.g. "estFactoryShipmentDate"
  label     String        // human-readable, e.g. "Est. Factory Shipment"
  fromDate  DateTime?
  toDate    DateTime?
  reason    String        // e.g. "Actual goods completion set"
  createdAt DateTime      @default(now())
}

model ShipmentAttachment {
  id         String   @id @default(cuid())
  shipmentId String
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  fileName   String
  url        String
  mimeType   String
  fileSize   Int
  uploadedAt DateTime @default(now())
}

// A single shipment's own pipeline position, independent of every other
// shipment on the same PO - different packing lists reach customs and
// arrive on different days. SHIPPED is the default; AT_CUSTOM is set by
// hand (picking which shipment(s) reached customs from the PO's "Mark:
// Custom Arrival" action); AT_CUSTOM_CLEARANCE is set by the "Mark: Custom
// Clearance" action; RECEIVED is derived once every item line is fully
// received or the shipment is confirmed complete despite a shortfall.
enum ShippingStatus {
  SHIPPED
  AT_CUSTOM
  AT_CUSTOM_CLEARANCE
  RECEIVED
}

model Shipment {
  id       String   @id @default(cuid())
  poId     String
  po       PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)

  shippingDate      DateTime
  transportMode     TransportMode
  shippedQty        Int
  receivedQty       Int?

  estCustomArrivalDate    DateTime?
  actualCustomArrivalDate DateTime?
  estCustomClearanceDate  DateTime?
  actualCustomDate        DateTime?
  estArrivalDate          DateTime?
  arrivalDate             DateTime?

  status      ShippingStatus @default(SHIPPED)
  customPoint String?
  notes       String?

  // Set when the user confirms, on a receivedQty < shippedQty mismatch
  // popup, that this packing list is fully received as entered (a real
  // shortage, not a partial receipt still in progress). Once set, this
  // shipment counts as complete for PO stage purposes even though its raw
  // quantities don't match.
  receivingConfirmed Boolean @default(false)

  items        ShipmentItem[]
  stageEvents  StageEvent[]
  attachments  ShipmentAttachment[]

  createdAt DateTime @default(now())
}

// One packing-list line within a Shipment: the quantity of a specific PO
// item actually shipped in that batch. A PI's goods may go out across
// several shipments and the per-shipment qty can differ from the PO's
// ordered qty, so this is tracked per shipment rather than assumed 1:1.
// receivedQty is a rollup of this line's ReceivingEvents, kept denormalized
// for quick display/rollups the same way PurchaseOrder mirrors POItem sums.
model ShipmentItem {
  id         String   @id @default(cuid())
  shipmentId String
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  poItemId   String
  poItem     POItem   @relation(fields: [poItemId], references: [id], onDelete: Cascade)

  shippedQty  Int
  receivedQty Int @default(0)
  actualCustomRateNPR Float?

  receivingEvents ReceivingEvent[]

  createdAt DateTime @default(now())
}

// One delivery event against a shipment line - goods for the same packing
// list can arrive in multiple batches on different days, each logged
// separately rather than overwriting a single receivedQty field.
model ReceivingEvent {
  id             String       @id @default(cuid())
  shipmentItemId String
  shipmentItem   ShipmentItem @relation(fields: [shipmentItemId], references: [id], onDelete: Cascade)

  receivedDate DateTime
  receivedQty  Int
  notes        String?

  createdAt DateTime @default(now())
}
